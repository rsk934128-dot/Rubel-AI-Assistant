rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validators
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt', 'lastLoginAt', 'status']) &&
             data.id == userId &&
             data.email is string && data.email.size() <= 200 &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 250)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('status' in data) || data.status in ['active', 'inactive', 'suspended']) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 60) || data.lastLoginAt is number || data.lastLoginAt is timestamp) &&
             ((data.createdAt is string && data.createdAt.size() <= 60) || data.createdAt is number || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60) || data.updatedAt is number || data.updatedAt is timestamp);
    }

    function isValidChatSession(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'mode', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'mode', 'createdAt', 'updatedAt', 'isPinned', 'pinnedAt', 'enableSearch']) &&
             data.userId == userId &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.mode in ['general', 'citizen', 'coding', 'writing', 'research', 'learning'] &&
             (data.createdAt is number || (data.createdAt is string && data.createdAt.size() <= 60)) &&
             (data.updatedAt is number || (data.updatedAt is string && data.updatedAt.size() <= 60)) &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('pinnedAt' in data) || data.pinnedAt == null || data.pinnedAt is number) &&
             (!('enableSearch' in data) || data.enableSearch is bool);
    }

    function isValidChatMessage(data, userId, sessionId) {
      return data.keys().hasAll(['id', 'sessionId', 'userId', 'role', 'content', 'timestamp']) &&
             data.keys().hasOnly(['id', 'sessionId', 'userId', 'role', 'content', 'timestamp', 'citations']) &&
             data.userId == userId &&
             data.sessionId == sessionId &&
             data.id is string && data.id.size() <= 128 &&
             data.role in ['user', 'assistant', 'system'] &&
             data.content is string && data.content.size() <= 50000 &&
             (data.timestamp is number || (data.timestamp is string && data.timestamp.size() <= 60)) &&
             (!('citations' in data) || (data.citations is list && data.citations.size() <= 50));
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // No public listing of users
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
                    (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User private chat sessions
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && isValidChatSession(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(sessionId) && isValidChatSession(incoming(), userId) &&
                      (!('id' in existing()) || incoming().id == existing().id) &&
                      (!('userId' in existing()) || incoming().userId == existing().userId);
        allow delete: if isOwner(userId) && isValidId(sessionId);

        // Messages in session
        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(messageId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming(), userId, sessionId);
          allow update: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming(), userId, sessionId) &&
                        (!('id' in existing()) || incoming().id == existing().id) &&
                        (!('userId' in existing()) || incoming().userId == existing().userId) &&
                        (!('sessionId' in existing()) || incoming().sessionId == existing().sessionId);
          allow delete: if isOwner(userId) && isValidId(messageId);
        }
      }
    }
  }
}
